# Godot 4+ specific ignores
.godot/
/android/

# UID sidecars Godot (D63) : générés localement par l'éditeur (F5 Windows) et
# JAMAIS par la VM aveugle → source de friction git (pull « untracked would be
# overwritten »). On n'en suit QUE ceux réellement référencés par uid:// :
#   - core/SpriteLoader.cs.uid  → autoload project.godot (uid SEUL, sans path)
#   - world/WorldView.cs.uid    → ext_resource de WorldView.tscn
# Tous les autres sont régénérables librement par Godot → ignorés.
*.uid
!core/SpriteLoader.cs.uid
!world/WorldView.cs.uid

# Claude Code — permissions locales par utilisateur + verrou runtime
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Caches Python du moteur de simulation (paquets : plants/ world/ fields/ sim/ tests/)
data/code/__pycache__/
data/code/**/__pycache__/

# Tranche 7 — artefacts PyInstaller (gel du moteur). Le .spec et la recette
# dans tools/ SONT versionnés ; build/, dist/ et binaires gelés non.
data/code/build/
data/code/dist/
data/code/tools/build/
data/code/tools/dist/
sim_server
sim_server.exe

# Maquettes SVG régénérables par tools/render_structure.py (cibles visuelles,
# pas des sources). Sorties du suivi au Sprint refactor global (SS①).
data/code/tools/*.svg
data/code/tools/*.svg.import

# Dumps runtime des pires ticks (capture perf, demande Nico 2026-07-05)
perf_dumps/
