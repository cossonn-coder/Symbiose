# Godot 4+ specific ignores
.godot/
/android/

# Claude Code — permissions locales par utilisateur + verrou runtime
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Caches Python du moteur de simulation (paquets : plants/ world/ fields/ sim/ tests/)
data/code/__pycache__/
data/code/**/__pycache__/

# Tranche 7 — artefacts PyInstaller (gel du moteur). Le .spec et la recette
# dans tools/ SONT versionnés ; build/, dist/ et binaires gelés non.
data/code/build/
data/code/dist/
data/code/tools/build/
data/code/tools/dist/
sim_server
sim_server.exe

# Maquettes SVG régénérables par tools/render_structure.py (cibles visuelles,
# pas des sources). Sorties du suivi au Sprint refactor global (SS①).
data/code/tools/*.svg
data/code/tools/*.svg.import
